# ===========================================================================
# Matcha 等价集成测试环境配置
#
# 用途：启动一个真实 NoneBot2 实例并在反向 WebSocket 模式下加载本插件，
# 以便外部 OneBot v11 客户端（如 Matcha，或本仓库的协议级测试驱动）连接。
# ===========================================================================
DRIVER=~fastapi

HOST=127.0.0.1
PORT=18080

# 反向 WebSocket：由本实例提供 WS 端点，等待协议端连入
ONEBOT_WS_URLS=["ws://127.0.0.1:18080/onebot/v11/ws"]

# 超级用户（重置最强 / 检查原神面板更新 / gsck 需要）
SUPERUSERS=["10001"]

# 使用无前缀命令匹配（与原真寻插件习惯一致）
COMMAND_START=[""]

# 本插件：使用独立的集成测试数据目录，避免污染默认数据
GENSHIN_ROLE_INFO_DATA_DIR=tests/_integration_data

# 关闭每日更新检查调度，避免测试期噪音
GENSHIN_ROLE_INFO_CHECK_UPDATE=false

LOG_LEVEL=INFO
