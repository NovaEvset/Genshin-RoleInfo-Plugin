# ===========================================================================
# NoneBot2 原神角色面板插件 —— 配置模板
#
# 使用方法：把本文件复制为 .env（或 .env.prod）并填入真实值。
# 本文件只包含占位符，请勿在其中写入任何真实凭据。
# ===========================================================================

# ---------------------------------------------------------------------------
# NoneBot2 基础配置（必需）
# ---------------------------------------------------------------------------
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8080

# OneBot v11 反向 WebSocket 路径。NapCat 需配置为连接此地址。
ONEBOT_WS_URLS=["ws://127.0.0.1:8080/onebot/v11/ws"]

# 超级用户 QQ 号（`重置最强`、`检查原神面板更新`、`gsck` 需要）
SUPERUSERS=["10001"]

# 命令起始符。留空表示不使用前缀（本插件按原项目习惯使用无前缀匹配）
COMMAND_START=[""]

# ---------------------------------------------------------------------------
# 本插件配置
# ---------------------------------------------------------------------------
# 用户数据目录（UID 绑定、角色缓存、群榜单、下载的图标）。
# 留空则使用插件包内的 user_data 目录；容器部署建议指向挂载卷。
GENSHIN_ROLE_INFO_DATA_DIR=

# 角色橱窗数据接口，逗号分隔、按顺序回退。
# 占位符为位置式 {}（与源实现一致），也接受 {uid} 写法。
GENSHIN_ROLE_INFO_API_URLS=https://profile.microgg.cn/api/uid/{},https://enka.network/api/uid/{}

# 单次橱窗数据请求的整体超时（秒）
GENSHIN_ROLE_INFO_REQUEST_TIMEOUT=120

# 是否启用每日一次的插件更新检查（需要安装 nonebot-plugin-apscheduler）
GENSHIN_ROLE_INFO_CHECK_UPDATE=true

# 远端版本号 / 更新说明地址（一般无需修改）
GENSHIN_ROLE_INFO_VERSION_URL=https://raw.githubusercontent.com/NovaEvset/Genshin-RoleInfo-Plugin/main/nonebot_plugin_genshin_role_info/__init__.py
GENSHIN_ROLE_INFO_CHANGELOG_URL=https://raw.githubusercontent.com/NovaEvset/Genshin-RoleInfo-Plugin/main/README.md

# ---------------------------------------------------------------------------
# 可选：米游社面板同步
#
# `米游社更新原神面板` 需要米游社登录态。原真寻插件依赖同仓库的 mys_sign
# 插件（扫码登录 + MysAPI），它不属于标准 NoneBot2 生态，因此这里改为
# 约定式注入：填写 `模块路径:属性名`，该对象需提供
#   - load_user(qq_id) -> dict | None
#   - MysAPI() 实例，实现 async get_genshin_character_details(user, uid=..., region=..., captcha_notifier=...)
#     与 async close()
# 留空则该命令返回配置指引，其余功能不受影响。
# ---------------------------------------------------------------------------
GENSHIN_ROLE_INFO_MYS_PROVIDER=

# ---------------------------------------------------------------------------
# 日志
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
